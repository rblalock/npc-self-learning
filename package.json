{
  "name": "tactical-air",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite apps/arena --host 127.0.0.1 --port 5173 --strictPort",
    "dev:ui": "vite apps/arena --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview apps/arena --host 127.0.0.1 --port 5174 --strictPort",
    "check": "tsc --noEmit",
    "build": "npm run build:wasm && npm run build:sdk && npm run check && node scripts/stamp-build.mjs && vite build apps/arena --base=./",
    "test": "cargo test --workspace && npm run build:wasm && npm run build:sdk && npm run test:arena && npm run test:synthetic && npm run test:retention && npm run test:research && npm run test:opportunity && npm run test:opportunity-v2 && npm run test:change && npm run test:conservative && npm run test:agentic",
    "compile:sim": "tsc apps/arena/src/sim.ts apps/arena/src/study.ts apps/arena/src/mission.ts apps/arena/src/playtest.ts --outDir target/arena-test --target es2022 --module esnext --moduleResolution bundler --skipLibCheck",
    "test:arena": "npm run compile:sim && node --test scripts/arena.test.mjs scripts/study.test.mjs scripts/sdk.test.mjs scripts/mission.test.mjs scripts/evaluation.test.mjs scripts/playtest.test.mjs",
    "evaluate:arena": "npm run compile:sim && node scripts/evaluate-arena.mjs",
    "evaluate:reversal": "npm run compile:sim && node scripts/evaluate-reversal.mjs",
    "test:ffi": "bash scripts/test-ffi.sh",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "evaluate:held-out": "npm run compile:sim && node scripts/evaluate-held-out.mjs",
    "evaluate:adaptation": "npm run build:wasm && npm run compile:sim && node scripts/evaluate-adaptation.mjs",
    "test:experiments": "node --test scripts/additive.test.mjs scripts/scenario.test.mjs",
    "verify:evidence": "node scripts/evidence-baseline.mjs && node scripts/verify-additive.mjs && node scripts/verify-scenarios.mjs",
    "test:synthetic": "node --test scripts/synthetic.test.mjs",
    "diagnose:feints": "node scripts/diagnose-feints.mjs",
    "verify:feints": "node scripts/synthetic/verify.mjs diagnostic",
    "evaluate:synthetic": "node scripts/evaluate-synthetic.mjs",
    "verify:synthetic": "node scripts/synthetic/verify.mjs population",
    "replay:synthetic": "node scripts/replay-synthetic-view.mjs",
    "package:synthetic": "node scripts/package-synthetic.mjs",
    "evaluate:boundary": "node scripts/evaluate-boundary.mjs",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "evaluate:retention": "node scripts/evaluate-retention.mjs",
    "verify:retention": "node scripts/verify-retention.mjs",
    "test:retention": "node --test scripts/retention.test.mjs",
    "replay:retention": "node scripts/replay-retention.mjs",
    "package:retention": "node scripts/package-retention.mjs",
    "test:research": "node --test scripts/research.test.mjs",
    "evaluate:research": "node scripts/evaluate-research.mjs",
    "verify:research": "node scripts/verify-research.mjs",
    "test:opportunity": "node --test scripts/opportunity-audit.test.mjs",
    "audit:opportunity": "node scripts/opportunity-audit.mjs",
    "replay:research": "node scripts/replay-research.mjs",
    "package:research": "node scripts/package-research.mjs",
    "test:opportunity-v2": "node --test scripts/opportunity-v2.test.mjs",
    "evaluate:opportunity-v2": "node scripts/evaluate-opportunity-v2.mjs",
    "verify:opportunity-v2": "node scripts/verify-opportunity-v2.mjs",
    "replay:opportunity-v2": "node scripts/replay-opportunity-v2.mjs",
    "package:opportunity-v2": "node scripts/package-opportunity-v2.mjs",
    "test:change": "node --test scripts/change-detection-v1.test.mjs",
    "evaluate:change": "node scripts/evaluate-change-detection-v1.mjs",
    "verify:change": "node scripts/verify-change-detection-v1.mjs",
    "replay:change": "node scripts/replay-change-detection-v1.mjs",
    "package:change": "node scripts/package-change-detection-v1.mjs",
    "test:conservative": "node --test scripts/conservative-v1.test.mjs",
    "evaluate:conservative": "node scripts/evaluate-conservative-v1.mjs",
    "verify:conservative": "node scripts/verify-conservative-v1.mjs",
    "replay:conservative": "node scripts/replay-conservative-v1.mjs",
    "package:conservative": "node scripts/package-conservative-v1.mjs",
    "build:microsite": "node scripts/build-microsite.mjs",
    "prepare:publication": "node scripts/prepare-publication.mjs",
    "check:privacy": "python3 scripts/check-publication-privacy.py",
    "compile:agentic": "tsc apps/arena/src/sim.ts --outDir target/agentic-sim --target es2022 --module esnext --moduleResolution bundler --skipLibCheck",
    "test:agentic": "npm run compile:agentic && node --test scripts/agentic-*.test.mjs",
    "evaluate:agentic": "npm run compile:agentic && node scripts/evaluate-agentic-v1.mjs",
    "verify:agentic": "npm run compile:agentic && node scripts/verify-agentic-v1.mjs",
    "test:agentic-v2": "npm run compile:agentic && node --test scripts/agentic-v2-*.test.mjs",
    "evaluate:agentic-v2": "npm run compile:agentic && node scripts/evaluate-agentic-v2.mjs",
    "verify:agentic-v2": "npm run compile:agentic && node scripts/verify-agentic-v2.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
